# Variables de entorno para el backend (copiar como backend/.env)

# Dataset de entrada
COVID_DATASET_PATH=/ruta/al/dataset/Casos_positivos_de_COVID-19_Colombia.csv

# Capa procesada
COVID_PROCESSED_DIR=/ruta/a/data/processed

# Ingesta por bloques
COVID_CHUNK_SIZE=100000
COVID_MEMORY_LIMIT_MB=1024
COVID_DEDUPLICATE=true
COVID_PARQUET_COMPRESSION=zstd

# Persistencia MongoDB
COVID_MONGO_URI=mongodb://localhost:27017
COVID_MONGO_DATABASE=covid_dashboard
COVID_MONGO_CASES_COLLECTION=casos_covid
COVID_MONGO_SUMMARY_COLLECTION=resumen_diario_municipios
COVID_MONGO_KPIS_COLLECTION=kpis_gerenciales
COVID_MONGO_DASHBOARD_COLLECTION=dashboard_agregados
COVID_MONGO_USERS_COLLECTION=usuarios
COVID_MONGO_BATCH_SIZE=5000
COVID_MONGO_ENABLED=true

# Seguridad y Autenticación JWT
COVID_JWT_SECRET_KEY=cambiar-por-una-clave-secreta-fuerte-en-produccion
COVID_JWT_ALGORITHM=HS256
COVID_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COVID_PASSWORD_HASH_ITERATIONS=600000
